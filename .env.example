# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=pcshop
POSTGRES_PASSWORD=pcshop
POSTGRES_DB=pcshop

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Outside Docker (e.g. running backend directly): use localhost
# Inside Docker Compose: the host is the service name "postgres"
DATABASE_URL=postgresql://pcshop:pcshop@localhost:5432/pcshop

# OpenTelemetry collector endpoint (OTLP/HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# All frontend env vars must be prefixed with VITE_
VITE_API_URL=http://localhost:4000

# ─── Grafana ──────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin